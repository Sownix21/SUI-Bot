[Unit]
Description=Obscura Telegram Bot
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=obscura-bot
Group=obscura-bot
WorkingDirectory=/var/lib/obscura-bot
EnvironmentFile=/etc/obscura-bot/obscura-bot.env
Environment=PYTHONUNBUFFERED=1
ExecStart=/opt/obscura-bot/.venv/bin/obscura-bot
Restart=on-failure
RestartSec=5s
TimeoutStopSec=30s

# systemd creates this writable directory as /var/lib/obscura-bot.
StateDirectory=obscura-bot
StateDirectoryMode=0750
UMask=0077

# Service hardening
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
RestrictSUIDSGID=true
RestrictRealtime=true
LockPersonality=true
MemoryDenyWriteExecute=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

[Install]
WantedBy=multi-user.target

