# Required secrets and endpoints
SUI_HOST=https://panel.example.com
SUI_TOKEN=replace-me
BOT_TOKEN=replace-me
ADMIN_TELEGRAM_ID=123456789

# Set true only when a trusted private S-UI host cannot use HTTPS.
ALLOW_INSECURE_HTTP=false

# Optional settings
ADMIN_CLIENT_ID=1
BACKUP_DIR=backups
BACKUP_MAX_BYTES=52428800
DB_NAME=Sui
REDIS_HOST=localhost
REDIS_ENABLED=false
REDIS_PORT=6379
REDIS_DB=0
RATE_LIMIT_WINDOW=60
MAX_REQUESTS_PER_WINDOW=10
RATE_LIMIT_SECONDS=1
BLOCK_DURATION=3600
ITEMS_PER_PAGE=5
RENEWAL_MONTHLY_PRICE=100000
RENEWAL_MONTH_OPTIONS=1,2,3
PAYMENT_CARD_NUMBER=0000-0000-0000-0000
PAYMENT_CARD_HOLDER=
BOT_DISPLAY_NAME=SUI Bot
HIDE_SUBSCRIPTION_PORT=false

# Leave blank under systemd to use journald only; set a path for local file logging.
BOT_LOG_FILE=
DATA_DIR=/var/lib/sui-bot
